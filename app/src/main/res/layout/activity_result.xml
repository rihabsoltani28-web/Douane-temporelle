<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rs_layout_resultat"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#2E7D32"
    android:padding="24dp">

    <TextView
        android:id="@+id/rs_tv_verdict"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="VERDICT"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/rs_tv_message"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/rs_tv_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Message personnalisé"
        android:textSize="22sp"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/rs_tv_verdict"
        app:layout_constraintBottom_toTopOf="@id/rs_btn_nouveau_voyageur"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/rs_btn_nouveau_voyageur"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nouveau voyageur"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/rs_tv_message"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
