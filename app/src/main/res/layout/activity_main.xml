<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#FFFFFF">

    <TextView
        android:id="@+id/rs_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="Douane temporelle"
        android:textColor="#1B2A49"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/rs_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:text="Formulaire d'identification du voyageur"
        android:textColor="#00695C"
        android:textSize="14sp" />

    <!-- سطر الاسم: الليبل يسار و الحقل يمين -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:weightSum="1">

        <TextView
            android:id="@+id/rs_label_nom"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.4"
            android:text="Nom du voyageur"
            android:textColor="#1B2A49"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/rs_nom"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.6"
            android:hint="Saisir le nom du voyageur"
            android:inputType="textPersonName"
            tools:ignore="TouchTargetSizeCheck" />
    </LinearLayout>

    <!-- سطر سنة الميلاد -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:weightSum="1">

        <TextView
            android:id="@+id/rs_label_naissance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.4"
            android:text="Année de naissance"
            android:textColor="#1B2A49"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/rs_annee_naissance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.6"
            android:hint="2005"
            android:inputType="number"
            android:maxLength="4"
            tools:ignore="TouchTargetSizeCheck" />
    </LinearLayout>

    <!-- سطر سنة الوصول -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:weightSum="1">

        <TextView
            android:id="@+id/rs_label_destination"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.4"
            android:text="Année de destination"
            android:textColor="#1B2A49"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/rs_annee_destination"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.6"
            android:hint="2050"
            android:inputType="number"
            android:maxLength="4"
            tools:ignore="TouchTargetSizeCheck" />
    </LinearLayout>

    <!-- سطر الدافع: الليبل يسار و الأزرار يمين -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:weightSum="1">

        <TextView
            android:id="@+id/rs_label_motif"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.4"
            android:text="Motif du voyage"
            android:textColor="#1B2A49"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rs_radio_group_motif"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.6"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rs_motif_tourisme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tourisme" />

            <RadioButton
                android:id="@+id/rs_motif_modification"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Modification du passé" />

            <RadioButton
                android:id="@+id/rs_motif_fuite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fuite" />
        </RadioGroup>
    </LinearLayout>

    <Button
        android:id="@+id/rs_btn_inspecter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="40dp"
        android:text="Inspecter le profil" />
</LinearLayout>